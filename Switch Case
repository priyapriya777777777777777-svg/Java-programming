import java.util.Scanner;
public class Main {
    public static void main(String[]args) {
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        switch (num % 2) {
            case 0:
                System.out.println("EVEN");
                break;
            default:
                System.out.println("ODD");
                break;
        }
    }

}
